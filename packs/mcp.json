      "id": "fastmcp-typescript",
      "language": "typescript",
      "source": "import { FastMCP } from \"fastmcp\"; const s=new FastMCP({}); s.addTool({name:\"lookup\",execute:async()=>\"ok\"});",
      "expect": {
        "mcp_server": 1,
        "tool": 1
      }
    },
    {
      "id": "fastmcp-edge",
