  "fixtures": [
    {
      "id": "fastmcp-server",
      "language": "python",
      "source": "from fastmcp import FastMCP\nserver=FastMCP(\"demo\")\n",
      "expect": {
        "mcp_server": 1
      }
    },
    {
      "id": "fastmcp-tool",
      "language": "python",
      "source": "from fastmcp import FastMCP\nserver=FastMCP(\"demo\")\n@server.tool\ndef lookup(): return \"ok\"\n",
      "expect": {
        "tool": 1
      }
    },
    {
      "id": "fastmcp-proxy",
      "language": "python",
      "source": "from fastmcp import FastMCP\ngateway=FastMCP.as_proxy(\"https://example.com/mcp\",name=\"gateway\")\n",
      "expect": {
        "mcp_gateway": 1
      }
    },
    {
      "id": "mcp-typescript-server",
      "language": "typescript",
      "source": "import {McpServer} from '@modelcontextprotocol/sdk/server/mcp.js'; const server=new McpServer({name:'demo',version:'1.0.0'});",
      "expect": {
        "mcp_server": 1
      }
    },
    {
      "id": "mcp-typescript-client",
      "language": "typescript",
      "source": "import {Client} from '@modelcontextprotocol/sdk/client/index.js'; const client=new Client({name:'demo',version:'1.0.0'});",
      "expect": {
        "mcp_client": 1
      }
    },
    {
      "id": "mcp-csharp-di",
      "language": "csharp",
      "source": "using Microsoft.Extensions.DependencyInjection; using Microsoft.Extensions.Hosting; var builder=Host.CreateApplicationBuilder(args); builder.Services.AddMcpServer().WithStdioServerTransport();",
      "expect": {
        "mcp_server": 1
      }
    },
    {
      "id": "mcp-rust-handler",
      "language": "rust",
      "source": "use rmcp::{tool_handler,ServerHandler}; struct Demo; #[tool_handler] impl ServerHandler for Demo {}",
      "expect": {
        "mcp_server": 1
      }
    },
    {
      "id": "mcp-rust-tool",
      "language": "rust",
      "source": "use rmcp::tool; struct Demo; impl Demo { #[tool(description=\"lookup\")] fn lookup(&self) -> String { \"ok\".into() } }",
      "expect": {
        "tool": 1
      }
    },
    {
      "id": "mcp-go-server",
      "language": "go",
      "source": "package app\nimport \"github.com/modelcontextprotocol/go-sdk/mcp\"\nfunc main(){ server:=mcp.NewServer(&mcp.Implementation{Name:\"demo\",Version:\"1.0.0\"},nil); _=server }\n",
      "expect": {
        "mcp_server": 1
      }
    },
    {
      "id": "mcp-import-only",
      "language": "python",
      "source": "from mcp.server.fastmcp import FastMCP\n",
      "expect": {
        "mcp_server": 0
      }
    },
    {
      "id": "mcp-unrelated-server",
      "language": "python",
      "source": "class Server: pass\nserver=Server()\n",
      "expect": {
        "mcp_server": 0
      }
    },
    {
      "id": "mcp-rust-wrong-trait",
      "language": "rust",
      "source": "use rmcp::tool_handler; #[tool_handler] impl OtherTrait for Demo {}",
      "expect": {
        "mcp_server": 0
      }
    },
    {
      "id": "mcp-csharp-unresolved",
      "language": "csharp",
      "source": "using Microsoft.Extensions.DependencyInjection; var services=GetOther(); services.AddMcpServer();",
      "expect": {
        "mcp_server": 0
      }
    },
    {
      "id": "fastmcp-client",
